{
  // Type-checks the plain-JavaScript helper, the scripts it requires, and the page bridge.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "files": [
    ".agents/skills/chippy/scripts/chippy-helper-server.js",
    "types/chippy-page-globals.d.ts",
    ".agents/skills/chippy/extension/frame-link.js",
    ".agents/skills/chippy/extension/chippy-page-bridge.js"
  ]
}
